import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class GuessNumberGame {
    
    // Declare UI components
    private JFrame frame;
    private JTextField textField;
    private JLabel feedbackLabel;
    private JLabel chancesLabel;
    private JButton submitButton;
    
    private int randomNumber; // Store the random number
    private int chancesLeft; // Number of chances left for the user

    public static void main(String[] args) {
        // Run the game
        SwingUtilities.invokeLater(new Runnable() {
            @Override
            public void run() {
                new GuessNumberGame().createAndShowGUI();
            }
        });
    }

    // Constructor to initialize the game
    public GuessNumberGame() {
        // Generate a random number between 1 and 100
        randomNumber = (int) (Math.random() * 100) + 1;
        chancesLeft = 5; // The user has 5 chances
    }

    // Method to create and show the GUI
    private void createAndShowGUI() {
        // Create the main frame
        frame = new JFrame("Guess the Number Game");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(400, 250);
        frame.setLayout(new FlowLayout());

        // Create and add UI components
        JLabel titleLabel = new JLabel("Guess the Number between 1 and 100");
        frame.add(titleLabel);

        textField = new JTextField(10);
        frame.add(textField);

        submitButton = new JButton("Submit Guess");
        frame.add(submitButton);

        feedbackLabel = new JLabel("");
        frame.add(feedbackLabel);

        chancesLabel = new JLabel("Chances Left: " + chancesLeft);
        frame.add(chancesLabel);

        // Add action listener to the submit button
        submitButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                handleGuess();
            }
        });

        // Make the frame visible
        frame.setVisible(true);
    }

    // Handle the guess logic when the button is clicked
    private void handleGuess() {
        // Get the user's guess
        try {
            int userGuess = Integer.parseInt(textField.getText());
            if (userGuess < 1 || userGuess > 100) {
                feedbackLabel.setText("Please guess a number between 1 and 100.");
                return;
            }
            
            // Check if the guess is correct
            if (userGuess == randomNumber) {
                feedbackLabel.setText("Correct! You've won!");
                feedbackLabel.setForeground(Color.GREEN);
                chancesLeft = 0; // End the game
            } else if (userGuess < randomNumber) {
                feedbackLabel.setText("Too Low!");
                feedbackLabel.setForeground(Color.RED);
                chancesLeft--;
            } else {
                feedbackLabel.setText("Too High!");
                feedbackLabel.setForeground(Color.RED);
                chancesLeft--;
            }

            // Update the chances left label
            chancesLabel.setText("Chances Left: " + chancesLeft);

            // If chances are over, show the "You Lost" message
            if (chancesLeft == 0 && userGuess != randomNumber) {
                feedbackLabel.setText("You Lost! The number was " + randomNumber);
                feedbackLabel.setForeground(Color.RED);
            }
        } catch (NumberFormatException ex) {
            feedbackLabel.setText("Invalid input! Please enter a number.");
        }

        // Disable the input and button after 5 chances
        if (chancesLeft == 0 || feedbackLabel.getText().contains("You Lost") || feedbackLabel.getText().contains("Correct")) {
            textField.setEditable(false);
            submitButton.setEnabled(false);
        }
    }
}
